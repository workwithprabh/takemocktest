{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://takemocktest.com/schema/question-bank.schema.json",
  "title": "TakeMockTest Question Bank",
  "description": "Validates an approved ChatGPT question-bank handoff (a bare Question[] array) before repository integration. Mirrors src/lib/questions.ts's Question interface. See TAKEMOCKTEST_CONTENT_SCHEMA.md for the full narrative reference and for ExamConfig/TestStage/TestConfig, which are not per-question and are not covered by this schema.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/question" },
  "definitions": {
    "questionSource": {
      "type": "object",
      "required": ["kind", "reference", "url", "checkedOn"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["original", "official-paper"] },
        "reference": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "question": {
      "type": "object",
      "required": ["section", "question", "explanation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctIndex": { "type": "integer" },
        "answerType": { "type": "string", "enum": ["mcq", "multi-select", "numerical"] },
        "correctValue": { "type": "string" },
        "correctIndices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 3 },
          "uniqueItems": true,
          "minItems": 1
        },
        "partialMarking": { "type": "boolean" },
        "maxDecimalPlaces": { "type": "integer", "minimum": 0 },
        "marks": { "type": "number", "exclusiveMinimum": 0 },
        "negativeMarking": { "type": "number", "minimum": 0 },
        "explanation": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/definitions/questionSource" }
      },
      "allOf": [
        {
          "if": { "properties": { "answerType": { "const": "numerical" } }, "required": ["answerType"] },
          "then": {
            "properties": {
              "options": { "type": "array", "maxItems": 0 },
              "correctIndex": { "const": -1 },
              "correctValue": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,2})?$" }
            },
            "required": ["correctValue"]
          }
        },
        {
          "if": { "properties": { "answerType": { "const": "multi-select" } }, "required": ["answerType"] },
          "then": {
            "properties": {
              "options": { "type": "array", "minItems": 4, "maxItems": 4 },
              "correctIndex": { "const": -1 },
              "correctIndices": { "type": "array", "minItems": 1 }
            },
            "required": ["options", "correctIndices"]
          }
        },
        {
          "if": {
            "anyOf": [
              { "not": { "required": ["answerType"] } },
              { "properties": { "answerType": { "const": "mcq" } }, "required": ["answerType"] }
            ]
          },
          "then": {
            "properties": {
              "options": { "type": "array", "minItems": 4, "maxItems": 4 },
              "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 }
            },
            "required": ["options", "correctIndex"]
          }
        }
      ]
    }
  }
}
